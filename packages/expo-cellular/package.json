  "homepage": "https://docs.expo.dev/versions/latest/sdk/cellular/",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "expo-module-scripts": "^55.0.2"
  },
  "peerDependencies": {
    "expo": "*"
  }
